<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/SCREEN"
    android:textAlignment="center">


    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="150sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:elevation="15dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/sampleimg"
                android:layout_width="120dp"
                android:layout_height="0dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="5sp"
                android:layout_marginBottom="5sp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                tools:srcCompat="@tools:sample/avatars" />

            <TextView
                android:id="@+id/restrauntname"
                android:layout_width="80dp"
                android:layout_height="25dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/button"
                android:fontFamily="@font/lato"
                android:paddingTop="4dp"
                android:text="@string/add_to_cart"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/foodprice"
                android:layout_width="62dp"
                android:layout_height="63dp"
                android:fontFamily="@font/lato"
                android:paddingTop="8dp"
                android:text="@string/_5"
                android:textAlignment="center"
                android:textColor="@color/green"
                android:textSize="35sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/restrauntname"
                app:layout_constraintEnd_toEndOf="@+id/restrauntname"
                app:layout_constraintStart_toStartOf="@+id/restrauntname"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/yeon_sung"
                android:text="@string/cart"
                android:textAlignment="center"
                style="@style/TEXT"
                android:textSize="25sp"
                app:layout_constraintBottom_toBottomOf="@+id/sampleimg"
                app:layout_constraintStart_toEndOf="@+id/sampleimg"
                app:layout_constraintTop_toTopOf="@+id/sampleimg" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>