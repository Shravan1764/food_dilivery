<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/txtvbackground"
    android:backgroundTint="#00FFFFFF"
    android:orientation="vertical"
    tools:context=".fragment.profileFragment">

    <!-- TODO: Update blank fragment layout -->

    <ImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/backbutton" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/yeon_sung"
        android:gravity="center_horizontal"
        android:text="@string/edit_profile"
        style="@style/TEXT"
        android:textSize="29sp" />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

    <LinearLayout
        android:id="@+id/nameprof"
        android:layout_width="wrap_content"
        android:layout_height="50dp"

        android:layout_marginTop="10sp"

        android:layout_marginBottom="10sp"
        android:background="@drawable/txtvbackground"
        android:elevation="25sp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView26"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/yeon_sung"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="@string/name"
            android:textColor="@color/black"
            android:textSize="30sp" />

        <EditText
            android:id="@+id/editTextText2"
            android:layout_width="356dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:ems="10"
            android:fontFamily="@font/yeon_sung"
            android:inputType="textMultiLine"
            android:paddingStart="10sp"
            android:text="@string/shravan_soni"
            android:textColor="#6D6B6B"
            android:textSize="25sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/adressprof"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="10sp"

        android:layout_marginBottom="10sp"
        android:background="@drawable/txtvbackground"
        android:elevation="25sp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView27"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/yeon_sung"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="@string/address"
            android:textColor="@color/black"
            android:textSize="30sp" />

        <EditText
            android:id="@+id/editTextText3"
            android:layout_width="356dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:ems="10"
            android:fontFamily="@font/yeon_sung"
            android:inputType="textMultiLine"
            android:paddingStart="10sp"
            android:padding="8dp"
            android:text="@string/dumm_addr"
            android:textColor="#6D6B6B"
            android:textSize="20sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/emailprof"
        android:layout_width="wrap_content"
        android:layout_height="50dp"

        android:layout_marginTop="10sp"

        android:layout_marginBottom="10sp"
        android:background="@drawable/txtvbackground"
        android:elevation="25sp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView28"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/yeon_sung"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="@string/email"
            android:textColor="@color/black"
            android:textSize="30sp" />

        <EditText
            android:id="@+id/editTextText4"
            android:layout_width="356dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:ems="10"
            android:fontFamily="@font/yeon_sung"
            android:inputType="textMultiLine"
            android:paddingStart="10sp"
            android:text="@string/mail"
            android:textColor="#6D6B6B"
            android:textSize="18sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/phonprof"
        android:layout_width="wrap_content"
        android:layout_height="50dp"

        android:layout_marginTop="10sp"

        android:layout_marginBottom="10sp"
        android:background="@drawable/txtvbackground"
        android:elevation="15sp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView29"
            android:layout_width="290dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/yeon_sung"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="@string/phoneno"
            android:textColor="@color/black"
            android:textSize="30sp" />

        <EditText
            android:id="@+id/editTextText5"
            android:layout_width="356dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:ems="10"
            android:fontFamily="@font/yeon_sung"
            android:inputType="textMultiLine"
            android:paddingStart="10sp"
            android:text="@string/num"
            android:textColor="#6D6B6B"
            android:textSize="25sp" />
    </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:elevation="100dp"
            android:background="@drawable/txtvbackground"
            android:text="@string/save_details"
            android:textColor="@color/lgreen"
            android:textAlignment="center"
            android:textSize="24sp"
            android:fontFamily="@font/yeon_sung"
            android:layout_marginTop="30dp"
            android:layout_marginStart="2sp"
            android:layout_marginEnd="2sp"
            android:layout_marginBottom="35dp"
            />
    </LinearLayout>
    </ScrollView>



</LinearLayout>